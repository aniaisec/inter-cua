# Copy to .env. .env is gitignored and must never be committed.

# Required only by `cua discover`. Tests and `cua replay` need no key.
ANTHROPIC_API_KEY=
CUA_MODEL=claude-sonnet-5

# Credential backing secret://local/mockcore/operator for the mock app.
# The mock app accepts operator/operator and holds no real data.
CUA_SECRET_MOCKCORE_OPERATOR=operator:operator

# Set to 1 to run the browser headed (handoff demos need this).
CUA_HEADED=0
