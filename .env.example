# Copy to .env. .env is gitignored and must never be committed.

# Model provider for `cua discover`. Tests and `cua replay` need no key.
# Set either key; with both, Claude is used unless CUA_LLM says otherwise.
ANTHROPIC_API_KEY=
CUA_MODEL=claude-sonnet-5
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest, which Google keeps pointed at
# its current Flash model.
CUA_GEMINI_MODEL=
# Optional: auto | anthropic | gemini. Same as --llm.
CUA_LLM=auto

# Credential backing secret://local/mockcore/operator for the mock app.
# The mock app accepts operator/operator and holds no real data.
CUA_SECRET_MOCKCORE_OPERATOR=operator:operator

# Approval tokens are signed with secret://local/cua/approval-signing-key,
# which tenants/local.yaml binds to the file .cua/approval-signing.key
# (gitignored; `cua approval-token` creates it on first use). Nothing to set.

# Set to 1 to run the browser headed (handoff demos need this).
CUA_HEADED=0
