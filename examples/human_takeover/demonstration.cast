[3.603, "o", "$ cua --root <example-output>\\project with spaces discover --name item_lookup --entry /login --goal Look up an item and return its available quantity and name --llm scripted --script <example-output>\\project with spaces\\scripts\\discovery\\item_lookup.yaml --param item_code:string=SKU-001 --output quantity:integer --output item_name:string\r\n"]
